# NFS-Ganesha Configuration
# Copy this file to .env and customize for your environment

# Export path inside container
# This is where NFS-Ganesha will serve files from
EXPORT_PATH=/data/nfs

# NFSv4 pseudo path
# This is the path clients use when mounting
PSEUDO_PATH=/

# Export ID
# Numeric identifier for this export (must be unique if multiple exports)
EXPORT_ID=0

# NFS protocols
# Options: 3, 4, or "3,4" for both
# Recommended: 4 (NFSv4 only)
PROTOCOLS=4

# Network transports
# Options: TCP, UDP, or "TCP, UDP"
TRANSPORTS=UDP, TCP

# Security type
# Options: sys, krb5, krb5i, krb5p
# Default: sys (no Kerberos)
SEC_TYPE=sys

# Root squash mode
# Options:
#   No_Root_Squash - root on client = root on server (default, less secure)
#   Root_Squash    - root on client = nobody on server (more secure)
#   All_Squash     - all users = nobody on server (most secure)
SQUASH_MODE=No_Root_Squash

# Graceless recovery
# true = faster restart, false = stateful recovery
GRACELESS=true

# Log verbosity
# Options:
#   NIV_NULL  - No logging
#   NIV_FATAL - Fatal errors only
#   NIV_WARN  - Warnings and above
#   NIV_EVENT - Events and above (recommended)
#   NIV_DEBUG - Debug logging (verbose)
#   NIV_FULL_DEBUG - Full debug (very verbose)
VERBOSITY=NIV_EVENT

# Image tag
# Specify version or 'latest'
IMAGE_TAG=latest

# Container name
CONTAINER_NAME=nfs-server

# Host data path
# Replace with your actual data directory
HOST_DATA_PATH=./data

# Port mappings
# Uncomment to customize ports (not usually needed)
# NFS_PORT=2049
# PORTMAPPER_PORT=111
# STATD_PORT=662

# Example configurations:

# Development (verbose logging):
# VERBOSITY=NIV_DEBUG

# Production (security hardened):
# SQUASH_MODE=Root_Squash
# PROTOCOLS=4
# VERBOSITY=NIV_WARN

# Multi-protocol support (NFSv3 and NFSv4):
# PROTOCOLS=3,4

# Custom export path:
# EXPORT_PATH=/exports
# Don't forget to update the volume mount in docker-compose.yml!
